---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Rail from '../components/Rail.astro';
import Story from '../components/Story.astro';
import Practices from '../components/Practices.astro';
import Engagements from '../components/Engagements.astro';
import Staffing from '../components/Staffing.astro';
import Delivery from '../components/Delivery.astro';
import Closing from '../components/Closing.astro';
import Enquiry from '../components/Enquiry.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/site';

const title = 'Oracle CPQ, Oracle CX and Salesforce Consulting | ConPriQuo';
const description =
  'Oracle CPQ, Oracle CX and Salesforce consulting, plus contract IT staffing. Based in Belagavi, India. Bring us a project to deliver or a role to fill.';

// Structured data always describes the production site, whatever origin or sub-path
// this copy is built for, so a preview build never claims to be the company's address.
const home = `${new URL(company.url).origin}/`;
const organizationId = `${home}#organization`;

/**
 * Structured data. Every statement below is also visible on the page, and nothing is
 * claimed that the company has not published: no ratings, awards, partner tiers,
 * founding date or headcount.
 */
const service = (name: string, serviceType: string, text: string) => ({
  '@type': 'Service',
  name,
  serviceType,
  description: text,
  provider: { '@id': organizationId },
  areaServed: 'Worldwide',
});

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: company.name,
      alternateName: company.shortName,
      url: home,
      logo: `${home}brand/conpriquo-solutions-logo.png`,
      image: `${home}og/conpriquo-solutions.png`,
      description:
        'ConPriQuo Solutions is an Oracle CPQ, Oracle CX and Salesforce consulting and specialized IT staffing company based in Belagavi, India, serving clients globally. It builds configure, price, quote systems for companies that sell complex products, and provides contract staffing and staff augmentation.',
      email: company.email,
      telephone: company.phoneDisplay,
      address: {
        '@type': 'PostalAddress',
        streetAddress: company.address.street,
        addressLocality: company.address.locality,
        addressRegion: company.address.region,
        addressCountry: company.address.countryCode,
      },
      areaServed: 'Worldwide',
      sameAs: [company.linkedin, company.instagram],
      knowsAbout: [
        'Oracle CPQ',
        'Oracle CX',
        'Salesforce',
        'Configure, price, quote (CPQ)',
        'BML',
        'CRM and ERP integration',
        'IT contract staffing',
        'IT staff augmentation',
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: company.email,
        telephone: company.phoneDisplay,
        areaServed: 'Worldwide',
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Consulting and staffing services',
        itemListElement: [
          service(
            'Oracle CPQ consulting',
            'Oracle CPQ implementation, enhancement and application support',
            'Product configuration with product models, bills of materials, constraints and guided selling; pricing and commerce with BML and BMQL logic, discounting, approvals and quote documents; integration with CRM and ERP, and support in production.',
          ),
          service(
            'Oracle CX consulting',
            'Oracle CX sales and service process consulting',
            'Sales processes covering account, opportunity and handoff workflows; service processes covering service requests, routing and escalation; records and handoffs mapped between Oracle CX and fulfillment systems.',
          ),
          service(
            'Salesforce consulting',
            'Salesforce consulting and customization',
            'Sales and service workflows with role-based access; customization and automation of business rules, approvals and handoffs; data migration, and quote and order data shared with CPQ and ERP.',
          ),
          service(
            'Specialized IT staffing',
            'Contract staffing and staff augmentation',
            'Contract staffing and staff augmentation for enterprise applications, engineering and integration, and cloud, data and operations roles. Candidates are shortlisted through a four-step process: align, source, screen, coordinate.',
          ),
        ].map((item) => ({ '@type': 'Offer', itemOffered: item })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      url: home,
      name: company.name,
      alternateName: company.shortName,
      inLanguage: 'en',
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'WebPage',
      '@id': `${home}#webpage`,
      url: home,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${home}#website` },
      about: { '@id': organizationId },
      primaryImageOfPage: { '@type': 'ImageObject', url: `${home}og/conpriquo-solutions.png`, width: 1200, height: 630 },
    },
  ],
};
---

<Base title={title} description={description} structuredData={structuredData}>
  <Header />
  <Rail />
  <main id="main">
    <Story />
    <Practices />
    <Engagements />
    <Delivery />
    <Staffing />
    <Closing />
  </main>
  <Footer />
  <Enquiry />
  <script>
    import '../scripts/main.ts';
  </script>
</Base>
