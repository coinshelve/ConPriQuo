---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { company } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** JSON-LD graph for the page. Only facts that are visible on the page belong here. */
  structuredData?: Record<string, unknown>;
  /** Path of the page relative to the site root, used for the canonical URL. */
  path?: string;
}

const { title, description, structuredData, path = '/' } = Astro.props;
// The base path is part of every asset URL, so the same source is correct at a
// domain root and under a sub-path.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const production = new URL(company.url).origin;
const origin = (Astro.site ?? new URL(company.url)).origin;
// A copy built for any other origin or sub-path (a preview host, a GitHub Pages project
// site) must not compete with the real site in search: it is marked noindex and its
// canonical and og:url still name the production address.
const isProduction = origin === production && base === '';
const robots = isProduction ? 'index, follow, max-image-preview:large, max-snippet:-1' : 'noindex, nofollow';
const canonical = `${production}${path.startsWith('/') ? path : `/${path}`}`;
// The share image is fetched from wherever this build is actually served.
const ogImage = `${origin}${base}/og/conpriquo-solutions.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/icons/icon-192.png`} />
    <link rel="apple-touch-icon" href={`${base}/icons/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ConPriQuo Solutions: Oracle CPQ, Oracle CX and Salesforce consulting, and specialized IT staffing" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-anek" preload />
    <Font cssVariable="--font-martian" />

    <script is:inline>
      // Marks scripting as available for progressive enhancement. If the page's own
      // script has not confirmed it is running a few seconds later, reveal everything.
      (function (d) {
        d.classList.add('js');
        setTimeout(function () {
          if (!window.__cpqReady) d.classList.add('reveal-fallback');
        }, 4500);
      })(document.documentElement);
    </script>

    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
