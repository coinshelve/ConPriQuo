---
/**
 * The three consulting practices, placed on the line a customer record actually
 * travels: lead, opportunity, quote, order, service request. Hovering or focusing a
 * practice lights the stations it works on.
 */
const stations = [
  { id: 'lead', label: 'Lead' },
  { id: 'opportunity', label: 'Opportunity' },
  { id: 'quote', label: 'Quote' },
  { id: 'order', label: 'Order' },
  { id: 'service', label: 'Service request' },
];

const practices = [
  {
    id: 'cpq',
    name: 'Oracle CPQ',
    stations: ['quote', 'order'],
    lines: [
      ['Product configuration', 'Product models, bills of materials, constraints and guided selling.'],
      ['Pricing and commerce', 'BML and BMQL logic, discounting, approvals and quote documents.'],
      ['Integration and support', 'Oracle CPQ connected to CRM and ERP, then supported in production.'],
    ],
  },
  {
    id: 'cx',
    name: 'Oracle CX',
    stations: ['opportunity', 'service'],
    lines: [
      ['Sales processes', 'Account, opportunity and handoff workflows built around how your sales teams work.'],
      ['Service processes', 'Service requests, routing and escalation with clear ownership.'],
      ['Enterprise integration', 'Records and handoffs mapped between Oracle CX and fulfillment systems.'],
    ],
  },
  {
    id: 'salesforce',
    name: 'Salesforce',
    stations: ['lead', 'opportunity', 'service'],
    lines: [
      ['Sales and service workflows', 'Lead, opportunity and case processes with role-based access.'],
      ['Customization and automation', 'Business rules, approvals and handoffs configured in Salesforce.'],
      ['Data migration and integration', 'Record mapping, cutover validation, and quote and order data shared with CPQ and ERP.'],
    ],
  },
];
---

<section class="practices theme-light" id="practices" aria-labelledby="practices-title" data-practices>
  <div class="wrap">
    <div class="practices__intro">
      <h2 class="chapter" id="practices-title">
        <span class="tag"><span>Practices<span class="visually-hidden">: </span></span></span>
        <span class="h2" data-lines>We work both sides of the quote.</span>
      </h2>
      <p class="body" data-reveal>
        Leads and opportunities feed the quote. Orders and service requests follow it. Our Oracle CPQ, Oracle CX
        and Salesforce practices cover every stop.
      </p>
    </div>

    <ol class="line" aria-label="Where each practice works along the customer lifecycle" data-reveal>
      {
        stations.map((station) => (
          <li class="line__station" data-station={station.id}>
            <span class="line__dot" aria-hidden="true" />
            <span class="line__label">{station.label}</span>
            <span class="line__who mono">
              {practices
                .filter((practice) => practice.stations.includes(station.id))
                .map((practice) => practice.name)
                .join(' / ')}
            </span>
          </li>
        ))
      }
    </ol>

    <div class="practices__cols">
      {
        practices.map((practice, index) => (
          <article class="practice" data-practice={practice.id} data-stations={practice.stations.join(' ')} data-reveal style={`--i:${index}`}>
            <h3 class="practice__name">{practice.name}</h3>
            <dl class="practice__lines">
              {practice.lines.map(([term, detail]) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{detail}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Light the stations a practice works on while that practice is hovered or focused.
  const root = document.querySelector<HTMLElement>('[data-practices]');
  if (root) {
    const stations = Array.from(root.querySelectorAll<HTMLElement>('[data-station]'));
    const practices = Array.from(root.querySelectorAll<HTMLElement>('[data-practice]'));
    const light = (ids: string[] | null, source?: HTMLElement) => {
      root.classList.toggle('is-filtered', Boolean(ids));
      for (const station of stations) station.classList.toggle('is-lit', Boolean(ids?.includes(station.dataset.station!)));
      for (const practice of practices) practice.classList.toggle('is-lit', practice === source);
    };
    for (const practice of practices) {
      const ids = (practice.dataset.stations ?? '').split(' ');
      practice.addEventListener('pointerenter', () => light(ids, practice));
      practice.addEventListener('pointerleave', () => light(null));
    }
    for (const station of stations) {
      const id = station.dataset.station!;
      station.addEventListener('pointerenter', () => {
        root.classList.add('is-filtered');
        station.classList.add('is-lit');
        for (const practice of practices) {
          practice.classList.toggle('is-lit', (practice.dataset.stations ?? '').split(' ').includes(id));
        }
      });
      station.addEventListener('pointerleave', () => light(null));
    }
  }
</script>

<style>
  .practices {
    background: var(--ground);
    padding-block: var(--section);
  }

  .practices__intro {
    display: grid;
    gap: clamp(1.1rem, 2.4vh, 1.75rem);
    max-width: 52rem;
  }

  /* ---- the lifecycle line ---- */
  .line {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: clamp(3rem, 7vw, 5.5rem);
    padding-top: 1.7rem;
  }

  .line::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0.3rem;
    height: 0.5rem;
    border-radius: 0.5rem;
    background: var(--magenta);
  }

  .line__station {
    position: relative;
    display: grid;
    gap: 0.3rem;
    align-content: start;
    padding-right: 0.75rem;
    transition: opacity var(--t-med) linear;
  }

  .line__dot {
    position: absolute;
    left: 0;
    top: -1.9rem;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--ground);
    box-shadow: inset 0 0 0 0.3rem var(--ink);
    transition:
      background-color var(--t-med) linear,
      transform var(--t-med) var(--ease-seat);
  }

  .line__label {
    font-size: var(--step-h3);
    font-weight: 600;
    font-stretch: 108%;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .line__who {
    font-size: 0.66rem;
    color: var(--ink-3);
    line-height: 1.5;
  }

  .is-filtered .line__station:not(.is-lit) {
    opacity: 0.32;
  }

  .line__station.is-lit .line__dot {
    background: var(--ink);
    transform: scale(1.18);
  }

  /* ---- three practices, set as specification columns ---- */
  .practices__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4.5rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .practice {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    transition: opacity var(--t-med) linear;
  }

  .is-filtered .practice:not(.is-lit) {
    opacity: 0.4;
  }

  .practice__name {
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
    font-weight: 600;
    font-stretch: 112%;
    letter-spacing: -0.028em;
    line-height: 1;
  }

  .practice__scope {
    color: var(--ink-2);
    text-wrap: pretty;
    min-height: 4.6em;
  }

  .practice__lines {
    display: grid;
    border-top: 2px solid var(--ink);
  }

  .practice__lines > div {
    display: grid;
    gap: 0.2rem;
    padding: 0.85rem 0 0.95rem;
    border-top: 1px solid var(--hair);
  }

  .practice__lines > div:first-child {
    border-top: 0;
  }

  .practice__lines dt {
    font-weight: 600;
    font-stretch: 104%;
  }

  .practice__lines dd {
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @media (max-width: 60rem) {
    .practices__cols {
      grid-template-columns: minmax(0, 1fr);
    }

    .practice__scope {
      min-height: 0;
    }
  }

  @media (max-width: 44rem) {
    /* The line turns vertical: stations stack down a magenta spine. */
    .line {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.4rem;
      padding-top: 0;
      padding-left: 2.4rem;
    }

    .line::before {
      left: 0.5rem;
      right: auto;
      top: 0.4rem;
      bottom: 0.4rem;
      width: 0.5rem;
      height: auto;
    }

    .line__dot {
      left: -2.4rem;
      top: 0.05rem;
    }

    .line__label {
      font-size: 1.35rem;
    }
  }
</style>
