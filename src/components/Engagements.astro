---
/**
 * Published Oracle CPQ engagements. Everything here restates what ConPriQuo has
 * already published about this work. No metrics, quotations or logos are added.
 */
import { company } from '../data/site';

const engagements = [
  {
    client: 'Terex ProAll',
    kind: 'Oracle CPQ global rollout',
    summary: 'Automated pricing, system integrations and quoting workflows for sales teams.',
  },
  {
    client: 'Terex Fuchs',
    kind: 'Oracle CPQ implementation',
    summary: 'Configured product rules, dynamic pricing and streamlined quote management.',
  },
];

/** The kinds of work involved, each one operated by the visitor in the example above. */
const work = [
  { term: 'Configuration', detail: 'Attribute-driven bill of materials structures.' },
  { term: 'Rules', detail: 'Constraint logic that keeps every configuration valid.' },
  { term: 'Pricing', detail: 'The Oracle CPQ Pricing Portal for discounting and pricing governance.' },
  { term: 'Commerce process', detail: 'Guided selling, quotation workflows and multi-level approvals.' },
];
---

<section class="engagements" id="engagements" aria-labelledby="engagements-title">
  <div class="wrap">
    <div class="engagements__head">
      <h2 class="chapter" id="engagements-title">
        <span class="tag"><span>Engagements<span class="visually-hidden">: </span></span></span>
        <span class="h2" data-lines>Two Oracle CPQ programs, on the record.</span>
      </h2>
    </div>

    <div class="engagements__grid">
      <ol class="records">
        {
          engagements.map((item, index) => (
            <li class="record" data-reveal style={`--i:${index}`}>
              <p class="record__kind mono">{item.kind}</p>
              <h3 class="record__client">{item.client}</h3>
              <p class="record__summary">{item.summary}</p>
            </li>
          ))
        }
      </ol>

      <div class="built" data-reveal>
        <p class="label built__label">What the work involved</p>
        <dl class="built__list">
          {
            work.map((item) => (
              <div>
                <dt>{item.term}</dt>
                <dd>{item.detail}</dd>
              </div>
            ))
          }
        </dl>
        <p class="built__note">We will walk you through what was built.</p>
        <a
          class="intent"
          href={`mailto:${company.email}`}
          data-enquiry
          data-enquiry-service="Oracle CPQ implementation"
          data-enquiry-note="We would like to hear about your Oracle CPQ work for Terex ProAll and Terex Fuchs."
        >
          Ask about either program
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .engagements {
    background: var(--ground-2);
    padding-block: var(--section);
  }

  .engagements__head {
    display: grid;
    gap: clamp(1.1rem, 2.4vh, 1.75rem);
  }

  .engagements__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 6vw, 7rem);
    margin-top: clamp(3rem, 6vw, 5.5rem);
    align-items: start;
  }

  .records {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .record {
    position: relative;
    display: grid;
    gap: 0.7rem;
    padding-left: clamp(1.5rem, 3vw, 2.75rem);
  }

  .record::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.15rem;
    bottom: 0.15rem;
    width: 0.5rem;
    border-radius: 0.5rem;
    background: var(--magenta);
  }

  .record__kind {
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .record__client {
    font-size: clamp(2.3rem, 1.3rem + 4.4vw, 4.6rem);
    font-weight: 600;
    font-stretch: 114%;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .record__summary {
    max-width: 30em;
    font-size: var(--step-lead);
    line-height: 1.45;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .built__label {
    color: var(--ink-2);
    padding-bottom: 0.8rem;
  }

  .built__list {
    display: grid;
    border-top: 2px solid var(--ink);
  }

  .built__list > div {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    padding: 0.95rem 0 1.05rem;
    border-top: 1px solid var(--hair);
  }

  .built__list > div:first-child {
    border-top: 0;
  }

  .built__list dt {
    font-weight: 600;
    font-stretch: 104%;
  }

  .built__list dd {
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .built__note {
    margin-top: 1.6rem;
    margin-bottom: 0.4rem;
    color: var(--ink-2);
    max-width: 34em;
  }

  @media (max-width: 60rem) {
    .engagements__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 30rem) {
    .built__list > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
