---
/**
 * Published Oracle CPQ engagements. Everything here restates what ConPriQuo has
 * already published about this work. No metrics, quotations or logos are added.
 */
const engagements = [
  {
    client: 'Terex ProAll',
    kind: 'Oracle CPQ global rollout',
    summary:
      'A global Oracle CPQ rollout for the ProAll brand: automated pricing, system integrations and quoting workflows for sales teams.',
  },
  {
    client: 'Terex Fuchs',
    kind: 'Oracle CPQ implementation',
    summary:
      'An Oracle CPQ implementation for the Fuchs division: configured product rules, dynamic pricing and streamlined quote management.',
  },
];

/** Each kind of work points back to the chapter above where the visitor operated it. */
const work = [
  {
    term: 'Configuration',
    detail: 'Advanced product configuration using attribute-driven bill of materials structures.',
    chapter: 'configure',
    label: 'Configure',
  },
  {
    term: 'Rules',
    detail: 'Business rules and constraint logic that keep every configuration valid as the seller builds it.',
    chapter: 'configure',
    label: 'Configure',
  },
  {
    term: 'Pricing',
    detail:
      'Integration with the Oracle CPQ Pricing Portal for central control of pricing strategy, dynamic discounting and pricing governance.',
    chapter: 'price',
    label: 'Price',
  },
  {
    term: 'Commerce process',
    detail:
      'A customized commerce process: guided selling, dynamic quotation workflows, transaction automation and multi-level approval hierarchies.',
    chapter: 'quote',
    label: 'Quote',
  },
];
---

<section class="engagements on-navy" id="engagements" aria-labelledby="engagements-title">
  <div class="wrap">
    <div class="engagements__head">
      <p class="tag tag--on-navy"><span>Engagements</span></p>
      <h2 class="h2" id="engagements-title" data-lines>Two Oracle CPQ programmes we can name.</h2>
    </div>

    <div class="engagements__grid">
      <ol class="records">
        {
          engagements.map((item, index) => (
            <li class="record" data-reveal style={`--i:${index}`}>
              <p class="record__kind mono">{item.kind}</p>
              <h3 class="record__client">{item.client}</h3>
              <p class="record__summary">{item.summary}</p>
            </li>
          ))
        }
      </ol>

      <div class="built" data-reveal>
        <p class="label built__label">What the work involved</p>
        <dl class="built__list">
          {
            work.map((item) => (
              <div>
                <dt>{item.term}</dt>
                <dd>
                  {item.detail}
                  <a class="built__see" href={`#${item.chapter}`}>
                    The same kind of logic, to operate: {item.label}
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="built__note">
          We do not publish figures we could not show you the source for. Ask about either programme and we will
          walk you through what was built, how it was integrated and what it took to roll out.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .engagements {
    background: var(--navy);
    color: var(--on-navy);
    padding-block: var(--section);
  }

  .engagements__head {
    display: grid;
    gap: clamp(1.1rem, 2.4vh, 1.75rem);
  }

  .engagements__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 6vw, 7rem);
    margin-top: clamp(3rem, 6vw, 5.5rem);
    align-items: start;
  }

  .records {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .record {
    position: relative;
    display: grid;
    gap: 0.7rem;
    padding-left: clamp(1.5rem, 3vw, 2.75rem);
  }

  .record::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.15rem;
    bottom: 0.15rem;
    width: 0.5rem;
    border-radius: 0.5rem;
    background: var(--magenta);
  }

  .record__kind {
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--on-navy-2);
  }

  .record__client {
    font-size: clamp(2.3rem, 1.3rem + 4.4vw, 4.6rem);
    font-weight: 600;
    font-stretch: 114%;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .record__summary {
    max-width: 30em;
    font-size: var(--step-lead);
    line-height: 1.45;
    color: var(--on-navy-2);
    text-wrap: pretty;
  }

  .built__label {
    color: var(--on-navy-2);
    padding-bottom: 0.8rem;
  }

  .built__list {
    display: grid;
    border-top: 2px solid var(--on-navy);
  }

  .built__list > div {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    padding: 0.95rem 0 1.05rem;
    border-top: 1px solid var(--hair-on-navy);
  }

  .built__list > div:first-child {
    border-top: 0;
  }

  .built__list dt {
    font-weight: 600;
    font-stretch: 104%;
  }

  .built__list dd {
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--on-navy-2);
    text-wrap: pretty;
  }

  .built__see {
    display: block;
    width: fit-content;
    margin-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-stretch: 94%;
    letter-spacing: 0.04em;
    color: var(--on-navy);
    text-decoration-color: var(--magenta);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  .built__see:hover {
    text-decoration-color: var(--on-navy);
  }

  .built__note {
    margin-top: 1.6rem;
    font-size: var(--step-small);
    line-height: 1.55;
    color: var(--on-navy-2);
    max-width: 34em;
  }

  @media (max-width: 60rem) {
    .engagements__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 30rem) {
    .built__list > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
