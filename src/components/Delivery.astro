---
/**
 * How a project runs: four phases, each under its own length of the logo's bar.
 */
const phases = [
  {
    name: 'Discover',
    text: 'Confirm goals, scope, system dependencies and what a successful release looks like.',
  },
  {
    name: 'Design and build',
    text: 'Review the design with your teams, then configure, develop and demonstrate the solution.',
  },
  {
    name: 'Test and release',
    text: 'Validate key scenarios, support user acceptance and agree on the cutover plan.',
  },
  {
    name: 'Handover',
    text: 'Document the solution, train users or support teams and agree on who owns what after launch.',
  },
];
---

<section class="delivery theme-light" id="delivery" aria-labelledby="delivery-title">
  <div class="wrap">
    <div class="delivery__intro">
      <h2 class="chapter" id="delivery-title">
        <span class="tag"><span>Project delivery<span class="visually-hidden">: </span></span></span>
        <span class="h2" data-lines>We define done before we start.</span>
      </h2>
    </div>

    <div class="run" data-reveal>
      <ol class="run__phases">
        {
          phases.map((phase) => (
            <li class="run__phase">
              <h3 class="run__name">{phase.name}</h3>
              <p class="run__text">{phase.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .delivery {
    background: var(--ground);
    padding-block: var(--section);
  }

  .delivery__intro {
    max-width: 52rem;
  }

  .run {
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .run__phases {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 3rem);
  }

  .run__phase {
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }

  /* One length of the logo's bar per phase: four segments, in order. */
  .run__phase::before {
    content: '';
    height: 0.5rem;
    margin-bottom: 0.9rem;
    border-radius: 0.5rem;
    background: var(--magenta);
  }

  .run__name {
    font-size: clamp(1.45rem, 1.1rem + 1.4vw, 2.2rem);
    font-weight: 600;
    font-stretch: 110%;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .run__text {
    font-size: var(--step-small);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @media (max-width: 60rem) {
    .run__phases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.25rem;
    }
  }

  @media (max-width: 34rem) {
    .run__phases {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Stacked, a full-width bar per phase is too heavy: each keeps a short one. */
    .run__phase::before {
      width: 2.1rem;
    }
  }
</style>
