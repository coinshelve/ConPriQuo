---
/**
 * The enquiry form, as a modal dialog. Every call to action on the page opens it,
 * optionally with a service already chosen.
 *
 * Delivery is decided at build time (see src/scripts/enquiry.ts): with a form
 * endpoint configured the request is posted to it; without one the dialog hands the
 * request to the visitor's own email app and says so. It never pretends to have sent
 * something it has not.
 */
import { company, enquiry } from '../data/site';
---

<dialog class="enquiry theme-light" id="enquiry" aria-labelledby="enquiry-title" data-enquiry-dialog>
  <div class="enquiry__frame">
    <aside class="enquiry__aside theme-dark">
      <p class="tag"><span>Contact</span></p>
      <h2 class="enquiry__title" id="enquiry-title">Tell us what you need.</h2>
      <p class="enquiry__sub">A project to deliver or a role to fill. A few lines are enough to start.</p>
      <dl class="enquiry__direct">
        <div>
          <dt class="label">Email</dt>
          <dd><a class="link" href={`mailto:${company.email}`}>{company.email}</a></dd>
        </div>
        <div>
          <dt class="label">Phone</dt>
          <dd><a class="link" href={`tel:${company.phoneHref}`}>{company.phoneDisplay}</a></dd>
        </div>
      </dl>
    </aside>

    <div class="enquiry__main">
      <button class="enquiry__close" type="button" data-enquiry-close>
        <span class="visually-hidden">Close</span>
        <span class="enquiry__close-mark" aria-hidden="true"></span>
      </button>

      <form class="enquiry__form" novalidate data-enquiry-form>
        <div class="field" data-field="service">
          <label for="enq-service">I need</label>
          <div class="select">
            <select id="enq-service" name="service" required>
              <option value="" selected disabled>Choose a service</option>
              {
                enquiry.services.map((group) => (
                  <optgroup label={group.label}>
                    {group.options.map((option) => <option value={option}>{option}</option>)}
                  </optgroup>
                ))
              }
            </select>
          </div>
          <p class="field__error" id="enq-service-error" hidden></p>
        </div>

        <div class="field-row">
          <div class="field" data-field="name">
            <label for="enq-name">Name</label>
            <input id="enq-name" name="name" type="text" autocomplete="name" maxlength="80" required />
            <p class="field__error" id="enq-name-error" hidden></p>
          </div>
          <div class="field" data-field="phone">
            <label for="enq-phone">Phone number</label>
            <input id="enq-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" required />
            <p class="field__error" id="enq-phone-error" hidden></p>
          </div>
        </div>

        <div class="field" data-field="email">
          <label for="enq-email">Business email</label>
          <input id="enq-email" name="email" type="email" autocomplete="email" maxlength="120" required />
          <p class="field__error" id="enq-email-error" hidden></p>
        </div>

        <div class="field" data-field="requirement">
          <label for="enq-requirement">Requirement <span class="field__optional">optional</span></label>
          <textarea id="enq-requirement" name="requirement" rows="3" maxlength="1200"></textarea>
        </div>

        <div class="enquiry__trap" aria-hidden="true">
          <label for="enq-website">Leave this field empty</label>
          <input id="enq-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="enquiry__actions">
          <button class="btn btn--accent" type="submit" data-enquiry-submit>Send request</button>
          <p class="enquiry__note" data-enquiry-note></p>
        </div>
        <p class="enquiry__status" role="alert" data-enquiry-status></p>
      </form>

      <div class="enquiry__done" data-enquiry-done hidden tabindex="-1">
        <span class="enquiry__done-mark" aria-hidden="true"></span>
        <p class="enquiry__done-title" data-enquiry-done-title></p>
        <p class="enquiry__done-text" data-enquiry-done-text></p>
        <div class="enquiry__done-actions">
          <a class="btn btn--small" href={`mailto:${company.email}`} data-enquiry-mailto>Open the email again</a>
          <button class="btn btn--small btn--line" type="button" data-enquiry-copy>Copy the details</button>
          <button class="btn btn--small btn--line" type="button" data-enquiry-close>Close</button>
        </div>
        <p class="enquiry__status" role="status" data-enquiry-copy-status></p>
      </div>
    </div>
  </div>
</dialog>

<style>
  .enquiry {
    width: min(60rem, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 0;
    border-radius: 3px;
    background: var(--white);
    color: var(--ink);
    overflow: auto;
    box-shadow:
      0 0 0 1px rgb(243 245 251 / 0.14),
      0 2.5rem 5rem -1.5rem rgb(3 4 20 / 0.7);
  }

  /* Anchored near the top instead of centred, so showing error messages only makes
     the dialog longer and never moves the fields the visitor is about to correct. */
  .enquiry {
    margin-top: clamp(1rem, 7vh, 5rem);
    margin-bottom: auto;
  }

  /* A browser that does not know the dialog element would otherwise print the closed
     form at the end of the page. */
  .enquiry:not([open]) {
    display: none;
  }

  .enquiry::backdrop {
    background: rgb(6 7 26 / 0.74);
  }

  /* A short window: tighter spacing so the form and its messages still fit. */
  @media (max-height: 46rem) and (min-width: 46.01rem) {
    .enquiry {
      margin-top: 1rem;
    }

    .enquiry__aside,
    .enquiry__main {
      padding-block: 1.5rem;
    }

    .enquiry__main {
      padding-top: 3rem;
    }

    .enquiry__form {
      gap: 0.85rem;
    }

    .field textarea {
      min-height: 4rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .enquiry[open] {
      animation: enquiry-in 420ms var(--ease-out);
    }

    .enquiry[open]::backdrop {
      animation: enquiry-fade 300ms linear;
    }

    @keyframes enquiry-in {
      from {
        opacity: 0;
        transform: translate3d(0, 1.25rem, 0);
      }
    }

    @keyframes enquiry-fade {
      from {
        opacity: 0;
      }
    }
  }

  .enquiry__frame {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    min-height: 100%;
  }

  /* ---- left: what this is, and the direct lines ---- */
  .enquiry__aside {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.5rem, 3.2vw, 2.75rem);
    background: var(--navy);
  }

  .enquiry__title {
    font-size: clamp(1.9rem, 1.3rem + 2vw, 2.9rem);
    font-weight: 640;
    font-stretch: 112%;
    letter-spacing: -0.03em;
    line-height: 1;
    text-wrap: balance;
  }

  .enquiry__sub {
    font-size: var(--step-lead);
    line-height: 1.4;
    color: var(--ink-2);
  }

  .enquiry__direct {
    display: grid;
    gap: 1.1rem;
    margin-top: auto;
    padding-top: 2rem;
  }

  .enquiry__direct dt {
    margin-bottom: 0.3rem;
  }

  .enquiry__direct dd {
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  /* ---- right: the form ---- */
  .enquiry__main {
    position: relative;
    padding: clamp(1.5rem, 3.2vw, 2.75rem);
    padding-top: clamp(3.25rem, 4vw, 3.5rem);
  }

  .enquiry__close {
    position: absolute;
    right: 0.6rem;
    top: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 2px;
    transition: background-color var(--t-fast) linear;
  }

  .enquiry__close:hover {
    background: var(--wash);
  }

  .enquiry__close-mark {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
  }

  .enquiry__close-mark::before,
  .enquiry__close-mark::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% - 1px);
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transform: rotate(45deg);
  }

  .enquiry__close-mark::after {
    transform: rotate(-45deg);
  }

  .enquiry__form {
    display: grid;
    gap: 1.15rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    min-width: 0;
  }

  /* Off screen, never focusable: a field only automated form fillers complete. */
  .enquiry__trap {
    position: absolute;
    left: -200vw;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.15rem 1rem;
  }

  .field label {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    font-stretch: 96%;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .field__optional {
    margin-left: 0.4rem;
    color: var(--ink-3);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.85rem;
    background: var(--white);
    border: 0;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px var(--hair-strong);
    font-size: 1.04rem;
    line-height: 1.4;
    color: var(--ink);
    transition: box-shadow var(--t-fast) linear;
  }

  .field textarea {
    min-height: 5.25rem;
    resize: vertical;
  }

  .select {
    position: relative;
  }

  .select select {
    appearance: none;
    -webkit-appearance: none;
    padding-right: 2.75rem;
    cursor: pointer;
    text-overflow: ellipsis;
  }

  /* the chevron: two strokes, drawn, so no icon font or image is needed */
  .select::after {
    content: '';
    position: absolute;
    right: 1.05rem;
    top: 50%;
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .field select:invalid {
    color: var(--ink-3);
  }

  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--ink);
  }

  .field.is-invalid input,
  .field.is-invalid select {
    box-shadow: inset 0 0 0 2px #b3261e;
  }

  .field__error {
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.35;
    color: #b3261e;
  }

  .enquiry__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.35rem;
  }

  .enquiry__note {
    flex: 1 1 14rem;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--ink-3);
  }

  .enquiry__status:empty {
    display: none;
  }

  .enquiry__status {
    font-size: 0.9rem;
    font-weight: 560;
    line-height: 1.4;
  }

  /* ---- after sending ---- */
  .enquiry__done {
    display: grid;
    gap: 0.9rem;
    align-content: center;
    min-height: 20rem;
    outline: none;
  }

  .enquiry__done-mark {
    width: 3rem;
    height: 0.7rem;
    border-radius: 0.7rem;
    background: var(--magenta);
  }

  .enquiry__done-title {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.2rem);
    font-weight: 640;
    font-stretch: 110%;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .enquiry__done-text {
    max-width: 30em;
    color: var(--ink-2);
  }

  .enquiry__done-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  @media (max-width: 46rem) {
    .enquiry {
      width: 100vw;
      max-height: 100dvh;
      height: 100dvh;
      margin: 0;
      border-radius: 0;
    }

    .enquiry__frame {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr;
    }

    .enquiry__aside {
      gap: 0.6rem;
      padding-right: 4rem;
    }

    .enquiry__direct {
      display: none;
    }

    .enquiry__main {
      padding-top: 1.5rem;
    }

    .enquiry__close {
      position: fixed;
      right: 0.5rem;
      top: 0.5rem;
    }

    .enquiry__close-mark::before,
    .enquiry__close-mark::after {
      background: var(--white);
    }

    .enquiry__close:hover {
      background: rgb(243 245 251 / 0.12);
    }
  }

  @media (max-width: 30rem) {
    .field-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
