---
/**
 * The second way to work with ConPriQuo. The logo's dots take over as the
 * protagonists: people. A second sticky stage follows the shortlist process,
 * Align, Source, Screen, Coordinate, exactly as the company describes it.
 */
import teamPoster from '../assets/posters/team-3.webp';
import { company } from '../data/site';

const families = [
  {
    id: 'apps',
    name: 'Enterprise applications',
    detail: 'Oracle CPQ consultants and BML developers. Oracle CX, Salesforce, ERP and CRM specialists, technical or functional.',
  },
  {
    id: 'engineering',
    name: 'Engineering and integration',
    detail: 'Application developers, middleware specialists, API engineers and testers.',
  },
  {
    id: 'cloud',
    name: 'Cloud, data and operations',
    detail: 'Cloud and DevOps engineers, data specialists and production support engineers.',
  },
];

const steps = [
  {
    id: 'align',
    name: 'Align',
    text: 'We agree on must-have skills, scope, location, start date and commercial terms before anyone is contacted.',
  },
  {
    id: 'source',
    name: 'Source',
    text: 'We find people with relevant project experience and confirm they are interested and available.',
  },
  {
    id: 'screen',
    name: 'Screen',
    text: 'We assess hands-on experience against the must-haves and flag the gaps worth probing in the interview.',
  },
  {
    id: 'coordinate',
    name: 'Coordinate',
    text: 'You receive a focused shortlist. We coordinate interviews, feedback and onboarding.',
  },
];
---

<section class="staffing" id="staffing" aria-labelledby="staffing-title" data-staffing>
  <div class="wrap">
    <div class="staffing__intro">
      <div class="staffing__lede">
        <h2 class="chapter" id="staffing-title">
          <span class="tag"><span>IT staffing<span class="visually-hidden">: </span></span></span>
          <span class="h2" data-lines>Sometimes the missing part is a person.</span>
        </h2>
      </div>
      <div class="staffing__body">
        <p class="lead" data-reveal>
          One BML developer. One integration engineer. One Salesforce administrator who has done it before.
          Contract staffing and staff augmentation. Every candidate is shortlisted against the role, not the
          keyword.
        </p>
      </div>
    </div>

    <fieldset class="families" data-families data-reveal>
      <legend class="label">Pick a skill family. Watch a shortlist take shape.</legend>
      <div class="families__list">
        {
          families.map((family, index) => (
            <label class="family" data-family={family.id}>
              <input type="radio" name="family" value={family.id} checked={index === 0} />
              <span class="family__dot" aria-hidden="true" />
              <span class="family__text">
                <span class="family__name">{family.name}</span>
                <span class="family__detail">{family.detail}</span>
              </span>
            </label>
          ))
        }
      </div>
      <p class="visually-hidden" role="status" data-family-status></p>
    </fieldset>

    <div class="shortlist">
      <div class="shortlist__stage" aria-hidden="true" data-nosnippet>
        <div class="stage" data-stage="team">
          <div class="stage__slot" data-team-slot>
            <noscript><img class="stage-poster" src={teamPoster.src} alt="" width={teamPoster.width} height={teamPoster.height} /></noscript>
          </div>
          <div class="stage__labels" data-team-labels></div>
          <p class="stage__caption mono" data-team-caption>Align</p>
        </div>
      </div>

      <ol class="shortlist__steps" aria-label="How we build a shortlist">
        {
          steps.map((step, index) => (
            <li class="phase" data-phase={step.id} data-index={index}>
              <h3 class="phase__name">{step.name}</h3>
              <p class="phase__text">{step.text}</p>
            </li>
          ))
        }
        <li class="shortlist__cta">
          <a
            class="btn btn--accent"
            href={`mailto:${company.email}`}
            data-enquiry
            data-enquiry-service="Contract specialists: Oracle CPQ, Oracle CX or Salesforce"
            data-family-cta
          >
            Request specialists
          </a>
        </li>
      </ol>
    </div>
  </div>
</section>

<script>
  // The chosen skill family travels with the request, as the service and as a note,
  // and is announced for anyone who cannot see the shortlist scene change.
  const SERVICE: Record<string, string> = {
    apps: 'Contract specialists: Oracle CPQ, Oracle CX or Salesforce',
    engineering: 'Contract specialists: engineering, cloud or data',
    cloud: 'Contract specialists: engineering, cloud or data',
  };
  const root = document.querySelector<HTMLElement>('[data-staffing]');
  const cta = root?.querySelector<HTMLElement>('[data-family-cta]');
  const status = root?.querySelector<HTMLElement>('[data-family-status]');
  root?.querySelectorAll<HTMLInputElement>('input[name="family"]').forEach((input) => {
    const apply = (announce: boolean) => {
      if (!input.checked) return;
      const name = input.closest('label')?.querySelector('.family__name')?.textContent?.trim() ?? '';
      if (cta) {
        cta.dataset.enquiryNote = `Skill family: ${name}.`;
        if (SERVICE[input.value]) cta.dataset.enquiryService = SERVICE[input.value];
      }
      if (status && announce) status.textContent = `Shortlist shown for ${name}.`;
    };
    apply(false);
    input.addEventListener('change', () => apply(true));
  });
</script>

<style>
  .staffing {
    background: var(--ground);
    padding-block: var(--section) calc(var(--section) * 0.7);
  }

  .staffing__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.5rem, 5vw, 6rem);
    align-items: end;
  }

  .staffing__lede {
    display: grid;
    gap: clamp(1.1rem, 2.4vh, 1.75rem);
  }

  /* ---- skill families: three of the logo's dots ---- */
  .families {
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .families legend {
    padding: 0 0 0.9rem;
  }

  .families__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--hair);
  }

  .family {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: 1.4rem 1.5rem 1.6rem 0;
    cursor: pointer;
    transition: background-color var(--t-fast) linear;
  }

  .family + .family {
    padding-left: 1.5rem;
    box-shadow: inset 1px 0 0 var(--hair);
  }

  .family input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: inherit;
  }

  .family:has(input:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  .family__dot {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.1rem;
    border-radius: 50%;
    background: var(--dot, var(--ink));
    box-shadow: inset 0 0 0 1.5px var(--ink);
    transform: scale(0.62);
    transition: transform var(--t-med) var(--ease-seat);
  }

  .family[data-family='apps'] {
    --dot: var(--magenta);
  }
  .family[data-family='engineering'] {
    --dot: var(--cyan);
  }
  .family[data-family='cloud'] {
    --dot: var(--orange);
  }

  .family:has(input:checked) .family__dot {
    transform: scale(1);
  }

  .family__text {
    display: grid;
    gap: 0.3rem;
  }

  .family__name {
    font-size: var(--step-h3);
    font-weight: 600;
    font-stretch: 106%;
    letter-spacing: -0.018em;
    line-height: 1.12;
    color: var(--ink-3);
    transition: color var(--t-fast) linear;
  }

  .family:hover .family__name,
  .family:has(input:checked) .family__name {
    color: var(--ink);
  }

  .family__detail {
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* ---- shortlist: sticky stage and the four steps ---- */
  .shortlist {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .shortlist__stage {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    height: clamp(13rem, 36svh, 27rem);
    margin-inline: calc(var(--gutter) * -1);
    background: var(--ground);
    box-shadow: 0 1px 0 var(--hair);
  }

  .stage {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: clip;
  }

  .stage__slot,
  .stage__labels {
    position: absolute;
    inset: 0;
  }

  .stage__labels {
    pointer-events: none;
  }

  .stage__slot :global(.stage-canvas) {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 700ms linear;
  }

  .stage__slot :global(.stage-canvas.is-ready) {
    opacity: 1;
  }

  .stage__caption {
    position: absolute;
    left: var(--gutter);
    bottom: 0.8rem;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .shortlist__steps {
    display: grid;
  }

  .phase {
    position: relative;
    display: grid;
    gap: 0.6rem;
    align-content: center;
    padding: clamp(2.25rem, 7vh, 4rem) 0 clamp(2.25rem, 7vh, 4rem) 3.4rem;
  }

  /* Phases out of focus step back to the lighter ink, which still meets AA contrast.
     The magenta mark, not opacity, says which phase the scene is showing. */
  .phase__name,
  .phase__text {
    transition: color var(--t-med) linear;
  }

  :global(.js) .phase:not(.is-current) .phase__name,
  :global(.js) .phase:not(.is-current) .phase__text {
    color: var(--ink-3);
  }

  .phase__name {
    position: relative;
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3.2rem);
    font-weight: 600;
    font-stretch: 112%;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  /* The mark belongs to the heading, so it sits on the heading's own line at every
     size. It lengthens into the logo's bar for the phase the scene is showing. */
  .phase__name::before {
    content: '';
    position: absolute;
    left: -3.4rem;
    top: 0.46em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 0.5rem;
    background: var(--ink-3);
    transition:
      width var(--t-med) var(--ease-out),
      background-color var(--t-med) linear;
  }

  .phase.is-current .phase__name::before,
  :global(html:not(.js)) .phase__name::before {
    width: 2.1rem;
    background: var(--magenta);
  }

  .phase__text {
    max-width: 30em;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .shortlist__cta {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    padding: 1rem 0 0 3.4rem;
  }

  /* A short, wide screen has no room for a pinned stage. */
  @media (max-width: 63.99rem) and (max-height: 30rem) {
    .shortlist__stage {
      position: static;
    }
  }

  @media (min-width: 64rem) {
    .shortlist {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      column-gap: clamp(2rem, 4vw, 5.5rem);
    }

    .shortlist__stage {
      height: calc(100svh - var(--header-h));
      margin-inline: calc(var(--gutter) * -1) 0;
      background: none;
      box-shadow: none;
      z-index: 1;
    }

    .stage__caption {
      bottom: 1.5rem;
    }

    .phase {
      min-height: 44svh;
    }

    .shortlist__steps {
      padding-block: 14svh 18svh;
    }
  }

  @media (max-width: 60rem) {
    .staffing__intro {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .families__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .family + .family {
      padding-left: 0;
      box-shadow: inset 0 1px 0 var(--hair);
    }
  }
</style>
